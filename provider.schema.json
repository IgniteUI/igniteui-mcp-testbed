{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "provider.schema.json",
  "title": "Provider pack (schema v2)",
  "description": "Describes how the testbed scaffolds, configures and serves a library. Editor aid only: validatePack in src/provider-registry.ts is the authority. A pack is <name>.json or <name>/pack.json under ./providers-data/.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "displayName", "frameworks"],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$", "not": { "enum": ["constructor", "prototype"] } },
    "argv": { "type": "array", "items": { "type": "string" } },
    "env": { "type": "object", "additionalProperties": { "type": "string" } },
    "include": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[A-Za-z0-9._*-]+$" }, "description": "Skill folder names to keep; * is a wildcard." },
    "relPath": { "type": "string", "minLength": 1, "not": { "pattern": "(^[\\\\/]|^[a-zA-Z]:|(^|[\\\\/])\\.\\.([\\\\/]|$))" } }
  },
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 2 },
    "name": { "$ref": "#/$defs/id", "not": { "const": "igniteui" }, "description": "Pack id. For a folder pack it must equal the folder name." },
    "displayName": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "version": { "type": "string" },
    "frameworks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "scaffold", "dev"],
        "properties": {
          "id": { "$ref": "#/$defs/id", "description": "Must not clash with a built-in framework (angular, react, webcomponents, blazor) or another pack's." },
          "label": { "type": "string", "minLength": 1 },
          "scaffold": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["cmd", "argv"],
                "properties": {
                  "kind": { "const": "command" },
                  "cmd": { "type": "string" },
                  "argv": { "$ref": "#/$defs/argv", "description": "Placeholders: {{name}} {{dir}} {{port}} {{agents}}." },
                  "cwdIsParent": { "type": "boolean", "description": "Run from the parent of the app dir (the command creates ./{{name}})." },
                  "env": { "$ref": "#/$defs/env" }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "from"],
                "description": "Folder packs only. Copies the folder into the app dir, filling {{name}} {{dir}} {{port}} {{agents}} in text files and names (other {{...}} is left as is), then runs npm install if there is a package.json.",
                "properties": {
                  "kind": { "const": "template" },
                  "from": { "$ref": "#/$defs/relPath" },
                  "env": { "$ref": "#/$defs/env" }
                }
              }
            ]
          },
          "install": { "type": "array", "items": { "type": "string" }, "description": "npm packages installed into the project after scaffold." },
          "dev": {
            "type": "object",
            "required": ["cmd", "argv"],
            "properties": {
              "cmd": { "type": "string" },
              "argv": { "$ref": "#/$defs/argv", "description": "Must bind 0.0.0.0:{{port}}." },
              "env": { "$ref": "#/$defs/env" }
            }
          },
          "prepare": {
            "type": "object",
            "description": "Files written into the app dir after scaffold: { relativePath: contents }.",
            "propertyNames": { "$ref": "#/$defs/relPath" },
            "additionalProperties": { "type": "string" }
          },
          "buildFailed": {
            "type": "array", "minItems": 1,
            "items": { "type": "string", "minLength": 1, "maxLength": 200 },
            "description": "Case-insensitive regexes; a match in the dev-server log after the agent's edits means the build failed (checked alongside the built-in markers)."
          },
          "routes": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind"],
            "description": "How screenshots find the app's pages. Default: route-config with the state-nav fallback.",
            "properties": {
              "kind": { "enum": ["route-config", "razor", "state-nav", "static"] },
              "fallback": { "const": "state-nav", "description": "Tried when the primary kind finds no routes." },
              "paths": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^/\\S*$" }, "description": "kind static only." }
            }
          }
        }
      }
    },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "classes": {
          "type": "array",
          "description": "What the user toggles. Ids are bare here and become <pack>/<class> at load (env override MCP_CMD_<PACK>_<CLASS>).",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label"],
            "properties": {
              "id": { "$ref": "#/$defs/id", "not": { "const": "custom" } },
              "label": { "type": "string", "minLength": 1 },
              "description": { "type": "string" },
              "default": { "type": "boolean", "default": true },
              "frameworks": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Only offered for these of the pack's framework ids." }
            }
          }
        },
        "servers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "class", "command"],
            "properties": {
              "name": { "$ref": "#/$defs/id" },
              "class": { "$ref": "#/$defs/id", "description": "One of mcp.classes[].id." },
              "command": { "type": "string", "minLength": 1 },
              "args": { "$ref": "#/$defs/argv" }
            }
          }
        }
      }
    },
    "skills": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "sources"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "description": "Wizard checkbox label." },
        "sources": {
          "type": "array",
          "description": "Installed in order; a later source replaces a same-named skill from an earlier one.",
          "items": {
            "oneOf": [
              { "type": "object", "additionalProperties": false, "required": ["github"],
                "properties": {
                  "github": { "type": "string", "pattern": "^[a-zA-Z0-9._-]+/[a-zA-Z0-9._-]+$", "description": "owner/repo" },
                  "ref": { "type": "string", "pattern": "^(?!-)(?!.*\\.\\.)[A-Za-z0-9._/-]{1,200}$", "description": "Branch, tag or commit sha. Default: the default branch." },
                  "path": { "$ref": "#/$defs/relPath", "description": "Skills folder inside the repo. Default: skills/ if present, else the root." },
                  "include": { "$ref": "#/$defs/include" } } },
              { "type": "object", "additionalProperties": false, "required": ["dir"],
                "properties": {
                  "dir": { "$ref": "#/$defs/relPath", "description": "Folder inside the pack (folder packs only)." },
                  "include": { "$ref": "#/$defs/include" } } },
              { "type": "object", "additionalProperties": false, "required": ["command"],
                "properties": { "command": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Run in .agents/skills/." } } }
            ]
          }
        }
      }
    },
    "options": {
      "type": "array",
      "description": "Wizard / matrix inputs; each value becomes the {{id}} placeholder in scaffold, dev and versions argv.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$", "not": { "enum": ["name", "dir", "port", "agents"] } },
          "label": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "placeholder": { "type": "string" },
          "choices": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Renders a select; the value must be one of these (or empty)." },
          "default": { "type": "string" }
        }
      }
    },
    "secrets": {
      "type": "array",
      "description": "License keys and the like. Given only to this pack's scaffold / install / dev-server steps, under their own name (an env secret's value, a file secret's path) or via {{secret:NAME}} in those steps' env — never argv, never the agent.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$", "not": { "enum": ["PATH", "HOME", "USER", "SHELL", "NODE_OPTIONS", "NODE_PATH", "LD_PRELOAD", "LD_LIBRARY_PATH"] },
            "description": "Without `file`, read from SECRET_<name> (environment or .env)." },
          "file": { "$ref": "#/$defs/relPath", "description": "Relative to ./secrets/<pack>/ on the host (/secrets/<pack>/ in the container)." },
          "required": { "type": "boolean", "default": true, "description": "A missing required secret fails the run before it starts." },
          "description": { "type": "string" }
        }
      }
    },
    "versions": {
      "type": "array",
      "description": "Commands whose first output line is an installed tool's version, run in the app dir after install and stored in history (config.toolVersions).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "cmd", "argv"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "cmd": { "type": "string" },
          "argv": { "$ref": "#/$defs/argv" },
          "frameworks": { "type": "array", "items": { "type": "string" }, "description": "Only for these framework ids." }
        }
      }
    },
    "containerDeps": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "npmGlobal": { "type": "array", "items": { "type": "string" } } }
    }
  }
}
