# Infragistics private-feed npm credentials for building the History grid with the
# licensed @infragistics packages (no watermark). Generate the token at
# https://account.infragistics.com/access-tokens.
# Leave IG_NPM_TOKEN unset to build the public trial (watermarked) grid.
# Copy this file to .env and fill in the values — .env is gitignored, never commit it.
IG_NPM_TOKEN=
IG_NPM_USERNAME=
IG_NPM_EMAIL=

# Provider API keys. run.sh / run.ps1 read this file and forward any of these that are
# set into the container, so a terminal-driven matrix (./run.sh --matrix-config <file>)
# resolves its key without a plaintext apiKey in the config: apiKeyEnv names one of
# these, or the provider default for the model's prefix is used. Set only the one(s) you
# need. Interactive UI runs take the key from the form instead and don't need these.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# Paired with a config's customBaseUrl (custom OpenAI-compatible endpoint).
CUSTOM_API_KEY=

# Point an MCP class at a locally-built server installed from ./local-mcp/*.tgz (see
# local-mcp/README.md). One var per class; the value is a whole command line. Any class
# works — igniteui, theming, angular, custom, or one a provider pack declares (a hyphen
# becomes an underscore: mui-docs -> MCP_CMD_MUI_DOCS). Unset => the released server.
# An already-exported value wins over this file, so a sweep can set it per arm.
# MCP_CMD_IGNITEUI=/opt/local-mcp/bin/igniteui-mcp
# MCP_CMD_THEMING=/opt/local-mcp/bin/my-theming-mcp
