# Dependencies
node_modules/

# Generated frontend bundles (esbuild output: vendored igniteui + our app bundle)
public/vendor/

# Session artifacts (generated apps, logs, stats)
sessions/

# User-loaded provider packs (bind-mounted at /providers; created by run.sh/run.ps1)
providers-data/

# User-supplied local skills (bind-mounted at /local-skills) — preserve the per-platform
# skeleton (README + empty angular/react/webcomponents/blazor dirs) but ignore the actual
# skill folders a user drops in.
local-skills/*
!local-skills/README.md
!local-skills/angular/
!local-skills/react/
!local-skills/webcomponents/
!local-skills/blazor/
local-skills/*/*
!local-skills/*/.gitkeep

# Logs
*.log

# Playwright output from any host-side test runs (in-container output lives under sessions/)
test-results/
playwright-report/

# Environment / secrets
.env
.env.*
!.env.example
# npm auth (private feed token) — never commit
.npmrc

# OS files
.DS_Store
Thumbs.db

docs/