# Dependencies
node_modules/

# Generated frontend bundles (esbuild output: vendored igniteui + our app bundle)
public/vendor/

# Session artifacts (generated apps, logs, stats)
sessions/

# User-loaded provider packs (bind-mounted at /providers; created by run.sh/run.ps1)
providers-data/

# User-supplied local skills (bind-mounted at /local-skills) — preserve the per-platform
# skeleton (README + empty angular/react/webcomponents/blazor dirs) but ignore the actual
# skill folders a user drops in.
local-skills/*
!local-skills/README.md
!local-skills/angular/
!local-skills/react/
!local-skills/webcomponents/
!local-skills/blazor/
local-skills/*/*
!local-skills/*/.gitkeep

local-skills-bak/*

# Locally-built Ignite UI MCP server tarballs, installed into the image at
# /opt/local-mcp and selected per run via IGNITEUI_MCP_CMD. Keep the dir (the
# Containerfile COPYs it, so it must exist), ignore the tarballs.
local-mcp/*
!local-mcp/.gitkeep
!local-mcp/README.md

# User-supplied prompt reference images (bind-mounted read-write at /prompt-images;
# the wizard's image uploads land here too) — keep the README, ignore the images.
prompt-images/*
!prompt-images/README.md

# Logs
*.log

# Playwright output from any host-side test runs (in-container output lives under sessions/)
test-results/
playwright-report/

# Environment / secrets
.env
.env.*
!.env.example
# npm auth (private feed token) — never commit
.npmrc

# OS files
.DS_Store
Thumbs.db

docs/
# Per-arm matrix configs generated by run-ab-sweep.sh from a shared base (only `name`
# differs) — regenerated every sweep, never edited by hand.
.ab-tmp/
